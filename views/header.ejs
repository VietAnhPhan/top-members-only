<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=title%>
    </title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>
    <header>
        <ul>
            <div class="header__brand"><a href="/">Home</a></div>
            <div class="header__account">
                <ul>
                    <% if(locals.user) { %>
                        <li><a href="/users/<%=user.user_name%>">Hello, <%=user.user_name%></a></li>
                         <li><a href="/users/<%=user.user_name%>/posts">My posts</a></li>
                        <li><a href="/posts/create">New Post</a></li>
                        <li><a href="/log-out">Log out</a></li>
                        <% } else {%>
                            <li><a href="/log-in">Log in</a></li>
                            <% } %>
                </ul>
            </div>

        </ul>
    </header>