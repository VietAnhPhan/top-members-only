<%- include('header', {title: title}) %>
  
    <% if (locals.user) {%>
      <div class="content__wrapper">
    <h1 class="content__title">Thoughts from junior, senior developers...</h1>
      <div class="content__inner">
        <div class="content__post_list">
          <% if(locals.posts) {%>
            <% const activePosts=locals.posts.filter(post=>post.is_active) %>
              <% activePosts.forEach(post=>{ %>
                <div class="post">
                  <h2 class="post__title">
                    <%=post.title%>
                  </h2>
                  <p class="post__body">
                    <%=post.body %>
                  </p>
                  <% const user=locals.user %>
                    <% if(user.membership_status==='private' || user.role==='admin' ) {%>
                      <div class="post__meta">
                        <p>
                          <%=user.first_name%>
                            <%=user.last_name%>
                        </p>
                        <p>
                          <%=user.user_name%>
                        </p>
                        <p>Written at: <%=post.created_at%>
                        </p>
                      </div>
                      <% } %>
                </div>
                <% }) %>
                  <% } %>
        </div>
      </div>
  </div>
  <% } else { %>

     
    <%- include('login') %>
      <%}%>




        <%- include('footer') %>