<%- include('header', {title: title}) %>
    <div class="content__wrapper">
        <h1 class="content__title">Post your thought here</h1>
        <div class="content__inner">
            <div class="form__submit">
                <form action="/posts/create" method="post">
                    <label for="post__title">Title: </label>
                    <input type="text" id="post__title" name="title" required>
                    <label for="post__body">Body: </label>
                    <textarea name="body" id="post__body" rows="15"></textarea>
                    <button type="submit">Post now</button>
                </form>
            </div>
        </div>
    </div>
    <%- include('partials/errors.ejs') %>

        <%- include('footer', {title: title}) %>