<%- include('header', {title: title}) %>
    <div class="content__wrapper">
    <h1>Your Posts</h1>

    <% if (locals.posts) {%>
        <ul>


            <% locals.posts.forEach(post=>{ %>
                <li>
                    <div class="post">
                        <p>
                            <%=post.title%>
                        </p>
                        <p>
                            <%=post.body %>
                        </p>
                    </div>
                </li>
                <% })} %>


        </ul>
        </div>

        <%- include('footer', {title: title}) %>